# Application Configuration & Metadata
APP_NAME="Memory-Augmented Chatbot"
APP_VERSION="0.1.0"
APP_BUILD_VERSION="2026.07.01"
APP_DESCRIPTION="Advanced Memory-Augmented AI Assistant powered by Knowledge Graphs and Hybrid RAG."
APP_ENV="production"
DEBUG=false
API_PREFIX="/api/v1"
SECRET_KEY="your-super-secret-key-change-in-production"

# Feature Flags
ENABLE_MEMORY=true
ENABLE_GRAPH=true
ENABLE_TOOLS=true
ENABLE_HYBRID_RAG=true
ENABLE_RERANKER=true
ENABLE_EVALUATION=false

# Model Registry Configuration
CHAT_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1.5"
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
RERANKER_MODEL="BAAI/bge-reranker-large"
EVALUATION_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1.5"
FALLBACK_MODEL="llama-3.1-8b-instant"

# NVIDIA NIM API Configuration (Primary Provider)
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1.5"
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=4096

# Groq LLM API Configuration (Fallback Provider)
GROQ_API_KEY="your-groq-api-key"
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096

# Retrieval & Hybrid RAG Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.75
RETRIEVAL_CHUNK_SIZE=512
RETRIEVAL_CHUNK_OVERLAP=64
RETRIEVAL_BM25_WEIGHT=0.4
RETRIEVAL_DENSE_WEIGHT=0.6

# Memory Configuration
MEMORY_CONVERSATION_WINDOW=10
MEMORY_THRESHOLD=0.8
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_LIMIT=100
MEMORY_RETENTION_DAYS=30

# Tools Configuration
WEATHER_API_KEY="your-weather-api-key"
WEATHER_ENABLED=true
NEWS_API_KEY="your-news-api-key"
NEWS_ENABLED=true
SEARCH_API_KEY="your-search-api-key"
SEARCH_ENABLED=true
TRANSLATION_ENABLED=true
CURRENCY_ENABLED=true

# Evaluation Configuration
EVAL_FAITHFULNESS_THRESHOLD=0.8
EVAL_GROUNDEDNESS_THRESHOLD=0.8
EVAL_LATENCY_TARGET_MS=2000
RAGAS_ENABLED=true
DEEPEVAL_ENABLED=true

# Storage — PostgreSQL (Railway/Neon/Supabase)
POSTGRES_URL="postgresql://user:password@host:5432/database"

# Storage — MongoDB
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="chatbot_memory"
MONGODB_MAX_CONNECTIONS=100

# Storage — Pinecone Vector Database
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="chatbot-vectors"
PINECONE_NAMESPACE="default"
PINECONE_DIMENSION=1024

# Storage — Neo4j Graph Database (Neo4j Aura)
NEO4J_URI="bolt://host:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"

# Logging Configuration
LOG_CONSOLE=true
LOG_FILE=true
LOG_LEVEL="INFO"
LOG_FORMAT_JSON=false
LOG_FILE_PATH="app.log"
LOG_MAX_FILE_SIZE_MB=10
LOG_RETENTION_FILES=5

# Frontend URL (for CORS/API base)
NEXT_PUBLIC_API_BASE_URL="https://your-backend-url.up.railway.app/api/v1"